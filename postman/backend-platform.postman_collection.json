{
  "info": {
    "name": "Backend Platform API",
    "description": "All endpoints of the backend platform. Run \"Auth / Login\" first: the test script stores accessToken and refreshToken in collection variables, so every other request is already authorized. Development seed account: admin / Admin@12345.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "managementUrl", "value": "http://localhost:8082" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "Admin@12345" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public endpoints: no token required.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login succeeded', () => pm.expect(body.success).to.eql(true));",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "  console.log('access token expires at', body.data.accessTokenExpiresAt);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "description": "Returns accessToken (15 minutes), refreshToken (30 days) and their expiry instants. The test script saves both tokens automatically."
          }
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('refresh succeeded', () => pm.expect(body.success).to.eql(true));",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "description": "Exchanges the refresh token for a new pair. Refresh tokens rotate: the old one stops working, the script stores the new one."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('logout succeeded', () => pm.expect(body.success).to.eql(true));",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] },
            "description": "Revokes the refresh token family and clears both token variables."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Requires the authorities seeded for the ADMIN role: user:read, user:create, user:update, user:delete, user:assign-role.",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "if (body.data && body.data.id) {",
                  "  pm.collectionVariables.set('userId', body.data.id);",
                  "  console.log('new userId =', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sara.mohammadi\",\n  \"password\": \"User@12345\",\n  \"fullName\": \"سارا محمدی\",\n  \"mobile\": \"09121234567\",\n  \"email\": \"sara@example.com\",\n  \"birthDatePersian\": \"1370/05/12\",\n  \"roles\": [\"USER\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] },
            "description": "Creates a user (201). Birth date arrives in the Persian calendar (yyyy/MM/dd); the response carries both Gregorian and Persian values. The script stores the new id in {{userId}}."
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] },
            "description": "One user by identifier (authority: user:read)."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"سارا محمدی\",\n  \"mobile\": \"09121234567\",\n  \"email\": \"sara@example.com\",\n  \"birthDatePersian\": \"1370/05/12\",\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] },
            "description": "Editable fields only: username and password are not part of this payload (authority: user:update)."
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 0,\n  \"size\": 20,\n  \"sortBy\": \"username\",\n  \"sortDirection\": \"ASC\",\n  \"keyword\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/search", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "search"] },
            "description": "Paged search served by JPA (authority: user:read). Filter fields: username, fullName, mobile, email, status, birthDate; common fields: page, size, sortBy, sortDirection, keyword, fromDate, toDate (yyyy-MM-dd). Sortable: username, fullName, status. Unknown sort fields answer SEARCH_INVALID_FIELD (COMMON-1501)."
          }
        },
        {
          "name": "Users report (SQL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 0,\n  \"size\": 20,\n  \"sortBy\": \"username\",\n  \"sortDirection\": \"ASC\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/report", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "report"] },
            "description": "Same criteria, hand-written SQL and a flat read model (authority: user:read)."
          }
        },
        {
          "name": "Change status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}", "status"] },
            "description": "Allowed values: ACTIVE, INACTIVE, LOCKED (authority: user:update)."
          }
        },
        {
          "name": "Assign roles",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\"USER\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}", "roles"] },
            "description": "Replaces the role set; seeded role codes are ADMIN and USER (authority: user:assign-role)."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] },
            "description": "Deletes the user in {{userId}} (authority: user:delete)."
          }
        }
      ]
    },
    {
      "name": "System",
      "description": "Documentation and health. Health is on the separate management port and reports DOWN while Redis is unreachable.",
      "item": [
        {
          "name": "OpenAPI document",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v3/api-docs", "host": ["{{baseUrl}}"], "path": ["v3", "api-docs"] },
            "description": "Machine readable description of every endpoint; Swagger UI renders it at {{baseUrl}}/swagger-ui/index.html."
          }
        },
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{managementUrl}}/actuator/health", "host": ["{{managementUrl}}"], "path": ["actuator", "health"] },
            "description": "503 with status DOWN is normal when Redis is not running locally; the database indicator is the one that matters for the API."
          }
        }
      ]
    }
  ]
}
